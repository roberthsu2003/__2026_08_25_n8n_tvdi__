        "jsCode": "const letters = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('');\nconst topics = ['職場溝通','旅遊交通','餐飲美食','科技網路','健康醫療','教育學習','商業金融','環境氣候','運動休閒','文化藝術','政治法律','科學研究','家庭生活','購物消費','社交情感','日常時間','自然動物','城市生活','求職面試','商務書信','會議簡報','客服應對','天氣季節','興趣愛好'];\nconst seeds = [\n  ...letters.map((L) => ({ json: { hint: `以 ${L} 開頭的常用英文單字` } })),\n  ...topics.map((t) => ({ json: { hint: `主題「${t}」相關的常用英文單字` } })),\n];\nreturn seeds;"
