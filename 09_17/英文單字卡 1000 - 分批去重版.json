    {
      "parameters": {
        "jsCode": "const items = $input.all().map((i) => i.json?.row || i.json).filter((r) => r && String(r.word || '').trim());\nconst esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;');\nconst escAttr = (s) => esc(s).replace(/'/g, '&#39;');\n\nfunction posMeta(pos) {\n  const p = String(pos || '').trim();\n  if (p.includes('名')) return { ch: '名', cls: 'noun' };\n  if (p.includes('動')) return { ch: '動', cls: 'verb' };\n  if (p.includes('形')) return { ch: '形', cls: 'adj' };\n  if (p.includes('副')) return { ch: '副', cls: 'adv' };\n  if (p) return { ch: p.charAt(0), cls: 'other' };\n  return { ch: '詞', cls: 'other' };\n}\n\nconst cards = items.map((r) => {\n  const word = esc(r.word);\n  const key = escAttr(String(r.word ?? '').toLowerCase());\n  const meta = posMeta(r.pos);\n  const progress = esc(r.progress || '不熟');\n  return '<article class=\"card ' + meta.cls + '\" data-word=\"' + key + '\" data-meaning=\"' + escAttr(r.meaning_zh) + '\" data-progress=\"' + escAttr(r.progress || '不熟') + '\">' +\n    '<div class=\"card-head\"><h2>' + word + '</h2><span class=\"pos-badge\" title=\"' + esc(r.pos) + '\">' + esc(meta.ch) + '</span></div>' +\n    '<p class=\"meaning\">' + esc(r.meaning_zh) + (r.extra ? '<span class=\"extra\">（' + esc(r.extra) + '）</span>' : '') + '</p>' +\n    '<blockquote class=\"example\">' + esc(r.example_en) + '</blockquote>' +\n    '<div class=\"card-foot\">' +\n      '<audio class=\"player\" controls preload=\"none\" src=\"' + escAttr(r.tts_url) + '\"></audio>' +\n      '<div class=\"seg\">' +\n        '<button class=\"seg-btn know\" data-state=\"\\u5df2\\u6703\" onclick=\"mark(this,\\'' + key + '\\',\\'\\u5df2\\u6703\\')\">\\u5df2\\u6703</button>' +\n        '<button class=\"seg-btn review\" data-state=\"\\u4e0d\\u719f\" onclick=\"mark(this,\\'' + key + '\\',\\'\\u4e0d\\u719f\\')\">\\u4e0d\\u719f</button>' +\n      '</div>' +\n    '</div>' +\n  '</article>';\n}).join('\\n');\n\nconst html = '<!DOCTYPE html><html lang=\"zh-Hant\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">' +\n'<title>英文單字卡</title>' +\n'<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\"><link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>' +\n'<link href=\"https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Noto+Sans+TC:wght@400;500;700&display=swap\" rel=\"stylesheet\">' +\n'<style>' +\n':root{--bg:#EFF2F0;--surface:#FFFFFF;--ink:#1B2430;--ink-soft:#5B6472;--line:#DEE3E1;--noun:#375D8C;--verb:#2E7D6B;--adj:#B4772B;--adv:#7B4B8A;--other:#6B7280;--know:#2E7D6B;--review:#C9553D;--focus:#375D8C;}' +\n'*{box-sizing:border-box}' +\n'body{margin:0;background:var(--bg);color:var(--ink);font-family:\"Noto Sans TC\",system-ui,sans-serif;line-height:1.5}' +\n'a,button,input{font-family:inherit}' +\n'.top{max-width:1100px;margin:0 auto;padding:32px 20px 12px}' +\n'.top h1{font-family:\"Fraunces\",serif;font-weight:600;font-size:2.1em;margin:0 0 6px;letter-spacing:.01em}' +\n'.stats{color:var(--ink-soft);font-size:.92em;margin:0}' +\n'.toolbar{position:sticky;top:0;z-index:5;background:rgba(239,242,240,.92);backdrop-filter:blur(6px);border-bottom:1px solid var(--line);padding:12px 20px;display:flex;gap:10px;max-width:1100px;margin:0 auto}' +\n'#q{flex:1;padding:10px 14px;border:1px solid var(--line);border-radius:8px;background:var(--surface);color:var(--ink);font-size:.95em}' +\n'#q:focus-visible{outline:2px solid var(--focus);outline-offset:1px}' +\n'.btn-primary{padding:10px 18px;border:none;border-radius:8px;background:var(--ink);color:#fff;font-size:.95em;cursor:pointer;white-space:nowrap}' +\n'.btn-primary:hover{background:#2c374a}' +\n'.btn-primary:focus-visible{outline:2px solid var(--focus);outline-offset:2px}' +\n'.grid{max-width:1100px;margin:0 auto;padding:24px 20px 60px;display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:20px}' +\n'.card{background:var(--surface);border:1px solid var(--line);border-left:4px solid var(--other);border-radius:8px;padding:18px 20px;transition:box-shadow .5s ease}' +\n'.card.noun{border-left-color:var(--noun)}.card.verb{border-left-color:var(--verb)}.card.adj{border-left-color:var(--adj)}.card.adv{border-left-color:var(--adv)}' +\n'.card-head{display:flex;align-items:baseline;justify-content:space-between;gap:10px}' +\n'.card-head h2{font-family:\"Fraunces\",serif;font-weight:600;font-size:1.7em;margin:0;word-break:break-word}' +\n'.pos-badge{flex:none;width:26px;height:26px;border-radius:50%;background:var(--bg);color:var(--ink-soft);font-size:.8em;display:flex;align-items:center;justify-content:center}' +\n'.card.noun .pos-badge{color:var(--noun)}.card.verb .pos-badge{color:var(--verb)}.card.adj .pos-badge{color:var(--adj)}.card.adv .pos-badge{color:var(--adv)}' +\n'.meaning{margin:8px 0 12px;font-size:1.02em}' +\n'.extra{color:var(--ink-soft);font-size:.88em;margin-left:4px}' +\n'.example{margin:0 0 14px;padding-left:12px;border-left:2px solid var(--line);color:var(--ink-soft);font-family:\"Fraunces\",serif;font-style:italic;font-size:.98em}' +\n'.card-foot{display:flex;align-items:center;gap:10px;flex-wrap:wrap}' +\n'.player{height:32px;flex:1;min-width:140px}' +\n'.seg{display:flex;border:1px solid var(--line);border-radius:7px;overflow:hidden;flex:none}' +\n'.seg-btn{border:none;background:var(--surface);color:var(--ink-soft);padding:7px 12px;font-size:.85em;cursor:pointer}' +\n'.seg-btn+.seg-btn{border-left:1px solid var(--line)}' +\n'.seg-btn.active.know{background:var(--know);color:#fff}' +\n'.seg-btn.active.review{background:var(--review);color:#fff}' +\n'.seg-btn:focus-visible{outline:2px solid var(--focus);outline-offset:-2px}' +\n'.card:target,.card.flash{box-shadow:0 0 0 3px var(--focus)}' +\n'@media (prefers-reduced-motion:no-preference){.flash{animation:pulse 1.1s ease}}' +\n'@keyframes pulse{0%{box-shadow:0 0 0 0 var(--focus)}70%{box-shadow:0 0 0 8px rgba(55,93,140,0)}100%{box-shadow:0 0 0 0 rgba(55,93,140,0)}}' +\n'.empty{max-width:1100px;margin:40px auto;padding:0 20px;color:var(--ink-soft)}' +\n'</style></head><body>' +\n'<div class=\"top\"><h1>英文單字卡</h1><p class=\"stats\" id=\"stats\"></p></div>' +\n'<div class=\"toolbar\"><input id=\"q\" type=\"search\" placeholder=\"搜尋單字或中文意思\" oninput=\"doFilter()\"><button class=\"btn-primary\" onclick=\"doRandom()\">隨機抽卡</button></div>' +\n(items.length ? '<main id=\"list\" class=\"grid\">' + cards + '</main>' : '<p class=\"empty\">目前還沒有單字，請先執行產生單字的工作流。</p>') +\n'<script>' +\n'var prog=JSON.parse(localStorage.getItem(\\'vocabProg\\')||\\'{}\\');' +\n'function paint(){document.querySelectorAll(\\'.card\\').forEach(function(c){var w=c.dataset.word;var s=prog[w]||c.dataset.progress;setState(c,s);});updateStats();}' +\n'function setState(card,s){card.querySelectorAll(\\'.seg-btn\\').forEach(function(b){b.classList.toggle(\\'active\\',b.dataset.state===s);});}' +\n'function mark(btn,w,s){prog[w]=s;localStorage.setItem(\\'vocabProg\\',JSON.stringify(prog));setState(btn.closest(\\'.card\\'),s);updateStats();}' +\n'function updateStats(){var cards=document.querySelectorAll(\\'.card\\');var known=0;cards.forEach(function(c){if(c.querySelector(\\'.seg-btn.know\\').classList.contains(\\'active\\'))known++;});var total=cards.length;document.getElementById(\\'stats\\').textContent=total?(\\'\\u5171 \\'+total+\\' \\u5f35\\u00b7\\u5df2\\u6703 \\'+known+\\'\\u00b7\\u5f85\\u52a0\\u5f37 \\'+(total-known)):\\'\\';}' +\n'function doFilter(){var q=document.getElementById(\\'q\\').value.trim().toLowerCase();document.querySelectorAll(\\'#list .card\\').forEach(function(c){var m=!q||c.dataset.word.indexOf(q)>-1||c.dataset.meaning.toLowerCase().indexOf(q)>-1;c.style.display=m?\\'\\':\\'none\\';});}' +\n'function doRandom(){var cs=[].slice.call(document.querySelectorAll(\\'#list .card\\')).filter(function(c){return c.style.display!==\\'none\\';});if(!cs.length)return;document.querySelectorAll(\\'.card.flash\\').forEach(function(c){c.classList.remove(\\'flash\\')});var c=cs[Math.floor(Math.random()*cs.length)];c.classList.add(\\'flash\\');c.scrollIntoView({behavior:\\'smooth\\',block:\\'center\\'});}' +\n'paint();' +\n'</scr' + 'ipt></body></html>';\nreturn [{ json: { html } }];"
      },
