    {
      "parameters": {
        "jsCode": "const existing = new Set(\n  $('讀取已有單字').all().map((i) => {\n    const r = i.json?.row ?? i.json ?? {};\n    return String(r.word ?? '').trim().toLowerCase();\n  }).filter(Boolean)\n);\nconst seen = new Set();\nconst rows = [];\nlet totalParsed = 0, skippedExisting = 0, skippedDup = 0, skippedInvalid = 0;\nfor (const item of $input.all()) {\n  const j = item.json ?? {};\n  let raw = j.text ?? j.output ?? j.content ?? '';\n  if (typeof raw !== 'string') raw = JSON.stringify(j);\n  raw = String(raw).replace(/```json/gi, '').replace(/```/g, '').trim();\n  let arr;\n  try { arr = JSON.parse(raw); }\n  catch (e) {\n    const m = String(raw).match(/\\[[\\s\\S]*\\]/);\n    if (!m) { skippedInvalid++; continue; }\n    try { arr = JSON.parse(m[0]); } catch (e2) { skippedInvalid++; continue; }\n  }\n  if (!Array.isArray(arr)) { skippedInvalid++; continue; }\n  for (const w of arr) {\n    totalParsed++;\n    const word = String(w.word ?? '').trim();\n    const meaning_zh = String(w.meaning_zh ?? '').trim();\n    const pos = String(w.pos ?? '').trim();\n    const example_en = String(w.example_en ?? '').trim();\n    if (!/^[A-Za-z][A-Za-z'\\- ]{1,30}$/.test(word)) { skippedInvalid++; continue; }\n    if (!meaning_zh) { skippedInvalid++; continue; }\n    const key = word.toLowerCase();\n    if (existing.has(key)) { skippedExisting++; continue; }\n    if (seen.has(key)) { skippedDup++; continue; }\n    seen.add(key);\n    rows.push({ json: {\n      word,\n      meaning_zh,\n      extra: '',\n      pos,\n      progress: '不熟',\n      example_en,\n      tts_url: 'https://translate.google.com/translate_tts?ie=UTF-8&tl=en&client=tw-ob&q=' + encodeURIComponent(word)\n    }});\n  }\n}\nif (rows.length === 0) {\n  throw new Error('組裝單字卡：無可用新單字（解析:' + totalParsed + ' 已存在:' + skippedExisting + ' 批次內重複:' + skippedDup + ' 無效:' + skippedInvalid + '）。請檢查 Ollama 回傳是否為純 JSON 陣列。');\n}\nreturn rows;"
      },
