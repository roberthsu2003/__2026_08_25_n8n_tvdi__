    {
      "parameters": {
        "jsCode": "const d=$input.all()[0]?.json||{};\nconst esc=v=>String(v).replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replaceAll('\"','&quot;');\nconst o=esc(d['名言(原文)']||d['名言']||'');\nconst a=esc(d['作者(原文)']||d['作者']||'');\nconst t=esc(d['翻譯成中文']||'');\nconst html='<!doctype html><html lang=\"zh-Hant\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>DAILY QUOTE · 每日名言</title><style>body{margin:0;font-family:-apple-system,BlinkMacSystemFont,\"Noto Sans TC\",\"Microsoft JhengHei\",sans-serif;background:linear-gradient(135deg,#eef2ff,#f8fafc);color:#172033;min-height:100vh;display:flex;align-items:center;justify-content:center;padding:24px;box-sizing:border-box}.card{width:min(860px,100%);background:rgba(255,255,255,.94);border:1px solid #e5e7eb;border-radius:28px;padding:42px;box-shadow:0 20px 60px rgba(15,23,42,.12)}.eyebrow{font-size:13px;letter-spacing:2px;text-transform:uppercase;color:#6366f1;font-weight:700;margin-bottom:30px}.label{font-size:14px;color:#64748b;font-weight:700;margin-bottom:10px}.quote{font-size:clamp(22px,3.5vw,32px);line-height:1.65;font-weight:650;margin:0}.en{font-size:18px;line-height:1.7;color:#475569;margin:12px 0 0}.author{margin-top:26px;font-weight:700;color:#334155}.divider{height:1px;background:#e5e7eb;margin:30px 0}.footer{font-size:13px;color:#94a3b8;text-align:center;margin-top:28px}.btn{display:inline-block;margin-top:28px;padding:12px 18px;border-radius:12px;background:#4f46e5;color:#fff;text-decoration:none;font-weight:700}</style></head><body><main class=\"card\"><div class=\"eyebrow\">DAILY QUOTE · 每日名言</div><section><div class=\"label\">繁體中文 · Traditional Chinese</div><p class=\"quote\">'+t+'</p></section><div class=\"divider\"></div><section><div class=\"label\">英文原文 · English Original</div><p class=\"en\">“'+o+'”</p><div class=\"author\">— '+a+'</div></section><a class=\"btn\" href=\"/webhook/random-quote\">重新取得名言 · New Quote</a><div class=\"footer\">Powered by n8n · AI Translation</div></main></body></html>';\nreturn [{json:{html}}];"
